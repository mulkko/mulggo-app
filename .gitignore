# 환경변수 / API 키
.env

# 파이썬 가상환경
venv/
.venv/
env/

# 파이썬 캐시
__pycache__/
*.pyc

# 주피터 노트북 체크포인트
.ipynb_checkpoints/

# OS/에디터 관련
.DS_Store
.vscode/

# 로컬 테스트용 DB 파일 (쓸 경우)
*.db
*.sqlite3

# 대용량/원본 데이터 (data/ 폴더 원칙상 대용량은 DB에 저장, 로컬 파일로 안 남기기)
data/raw/
data/**/*.csv
# 예외: KSIC 마스터(소규모 정적 참고자료). 분류기(explicit_match.py)가 이 경로를
# 직접 읽고, load_ksic_codes.py가 ksic_codes 테이블 시드로도 씀.
!data/ksic_clean_v2.csv
data/**/*.xls
data/**/*.xlsx
# 예외: 신청서 자동채우기(backend/assistant) 필드매핑표(소규모 정적 참고자료).
# 원래 팀원 개인 PC(Downloads)에만 있던 파일이라 저장소로 옮김(2026-09-09).
!data/field_mapping.xlsx

# data/ 폴더에 들어오는 이미지 (테스트용 사업자등록증 사진 등 개인정보 포함 가능 — DB/로컬에만 두고 git에는 안 올림)
data/**/*.jpg
data/**/*.jpeg
data/**/*.png

# 회원가입/OCR 테스트 시 업로드된 실제 파일 (개인정보 포함 가능 — 사업자등록증 등)
data/uploads/
data/test_uploads/
frontend/dev/*_test.*

# 관리자 "통합 반영" 실행 로그 (subprocess stdout)
logs/

# 전처리 파이프라인 dry-run 결과물 (로컬 확인용)
dryrun_sync_*.xlsx

# 로컬에서 backend/frontend를 백그라운드로 띄울 때 생기는 임시 stdout/stderr 로그
/_*.log

# 작업 중 임시로 남겨둔 백업 파일 (예: 프론트 붙이기 전 원본 보관용, 다 되면 삭제 예정)
*.bak

# 업종코드 매칭 — 로컬 벡터DB (바이너리, 74MB). 재생성:
#   cd backend/ml/industry_code_matching
#   python business_matching/34_reindex_local.py --model bge-m3
backend/ml/industry_code_matching/chroma_db/
backend/ml/industry_code_matching/__pycache__/
backend/ml/industry_code_matching/business_matching/__pycache__/
