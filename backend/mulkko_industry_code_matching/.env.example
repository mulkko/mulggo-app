# 이 파일을 .env 로 복사하고 값을 채우세요. (또는 서버 환경변수로 직접 주입)
OPENAI_API_KEY=sk-여기에_실제_키
LLM_MODEL=gpt-5-mini

# 임베딩 백엔드 (개정 계획서 §6.4, embedders.py):
#   text-embedding-3-small : OpenAI (기존 인덱스 chroma_db/business_code_docs_2025)
#   bge-m3                  : 로컬 GPU 무료 (chroma_db/business_code_docs_bge_m3, 34번으로 구축)
EMBEDDING_MODEL=bge-m3

# 주의:
# - EMBEDDING_MODEL 을 바꾸면 그 모델용 인덱스가 있어야 한다.
#     OpenAI  -> 26_build_business_code_docs_chroma.py
#     로컬    -> 34_reindex_local.py --model bge-m3   (GPU, ~72초, 크레딧 0)
# - bge-m3 사용 시 torch + sentence-transformers 필요 (requirements.txt).
# - LLM_MODEL 은 교체 가능. gpt-5-mini 로 성능 측정.
