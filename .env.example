# 이 파일을 복사해서 .env로 저장한 뒤 실제 값으로 채워주세요.
# cp .env.example .env

# 기업마당(bizinfo) API키
BIZINFO_API_KEY=

# 창업진흥원(K-Startup) API키 (backend/crawler/kst_api.py)
KStartup_API_KEY=

# 특허정보원(KIPRIS) API키 (backend/analysis_report/tech_startup/patent_forecast.py)
KIPRIS_API_KEY=

# DB 정보 (Supabase / PostgreSQL)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# 매칭 재정렬 LLM (backend/ml/classifier/llm_match.py)
# LLM_PROVIDER=openai 면 OPENAI_API_KEY, gemini 면 GOOGLE_API_KEY 필요.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEBUG_LLM=0
