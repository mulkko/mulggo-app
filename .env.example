# 이 파일을 복사해서 .env로 저장한 뒤 실제 값으로 채워주세요.
# cp .env.example .env

# 기업마당(bizinfo) API키
BIZINFO_API_KEY=

# 창업진흥원(K-Startup) API키 (backend/crawler/kst_api.py)
KStartup_API_KEY=

# 특허정보원(KIPRIS) API키 (backend/analysis_report/tech_startup/patent_forecast.py)
KIPRIS_API_KEY=

# DB 정보 (Supabase / PostgreSQL)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# 상권분석용 대용량 참고 데이터 전용 DB (별도 Supabase 프로젝트).
# commercial_districts(전국 상가업소 270만 건, ~741MB)가 메인 DB 무료 플랜
# 저장 용량(500MB)을 초과시켜 읽기전용으로 잠기는 문제가 있어 분리함
# (2026-09-08). 이 테이블은 users/announcements 등과 FK로 안 엮여 있어서
# 분리해도 기존 기능에 영향 없음. backend/db/connection.py::get_analysis_connection()
ANALYSIS_DB_HOST=
ANALYSIS_DB_PORT=
ANALYSIS_DB_NAME=
ANALYSIS_DB_USER=
ANALYSIS_DB_PASSWORD=

# [개발 전용] 자동 로그인 계정 - 로컬 .env에만 채워서 씀, 절대 커밋 금지.
# 채워두면 POST /api/auth/dev-auto-login이 이 계정으로 대신 로그인해서 토큰을
# 내려준다(팀원들이 같은 네트워크에서 테스트할 때 매번 로그인 폼 안 거치게 하는 용도).
# 비워두면(대부분의 환경) 자동로그인 자체가 비활성화됨.
DEV_AUTO_LOGIN_EMAIL=
DEV_AUTO_LOGIN_PASSWORD=

# [개발 전용] 관리자 로그인 화면용 자동 로그인 계정 (is_admin=true 계정이어야 함).
# POST /api/auth/dev-auto-login-admin에서 사용. 위와 마찬가지로 비워두면 비활성화.
DEV_ADMIN_AUTO_LOGIN_EMAIL=
DEV_ADMIN_AUTO_LOGIN_PASSWORD=

# 매칭 재정렬 LLM (backend/ml/classifier/llm_match.py)
# LLM_PROVIDER=openai 면 OPENAI_API_KEY, gemini 면 GOOGLE_API_KEY 필요.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEBUG_LLM=0

# 업종코드 매칭 (backend/ml/industry_code_matching) — 이름이 위 LLM_MODEL과 겹치면
# 그쪽 기본 동작(gpt-4o-mini)까지 같이 바뀌어서 접두사로 구분함.
# OPENAI_API_KEY는 위 값을 그대로 씀(별도 발급 불필요).
INDUSTRY_MATCH_LLM_MODEL=gpt-5-mini
INDUSTRY_MATCH_EMBEDDING_MODEL=bge-m3
